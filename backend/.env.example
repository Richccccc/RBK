# 复制本文件为 .env，并按实际情况修改
# MySQL / TiDB 连接串（推荐 utf8mb4）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/blog?charset=utf8mb4

# TLS 两种方式二选一（本地 MySQL 两种都留空）：
# 方式一：填 TiDB 下载的 CA 证书绝对路径，校验服务器证书（更安全）
DB_SSL_CA=
# 方式二：设 true 启用 TLS 但不校验（TiDB Serverless 最省事，无需下载证书）
DB_SSL=false

# JWT 签名密钥（请改成随机字符串）
JWT_SECRET=please-change-me-to-a-random-string

# 令牌有效期（分钟），默认 7 天
TOKEN_EXPIRE_MINUTES=10080

# 单张图片最大字节数（默认 5MB）
MAX_IMAGE_BYTES=5242880